# Copie para .env e preencha. NUNCA versione o .env.
# Ambiente ativo: development | staging | production
APP_ENV=development

# --- LLM ---
# fake = provedor determinístico offline (padrão para dev/test)
# anthropic = Claude via SDK oficial
APP_LLM__PROVIDER=fake
APP_LLM__MODEL=claude-opus-5-5
APP_LLM__FALLBACK_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Segurança ---
# Chaves de API aceitas, separadas por vírgula, no formato <chave>:<papel>
APP_SECURITY__API_KEYS=dev-key-change-me:admin
APP_SECURITY__JWT_SECRET=change-me-in-every-environment

# --- Observabilidade ---
APP_OBSERVABILITY__LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- MCP ---
GITHUB_MCP_TOKEN=
